{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "maxLength": 50
    },
    "hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "max_articles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "publisher_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "interests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10
          },
          "required_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "keywords",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "enabled": {
            "type": "boolean"
          },
          "quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "allow_article_fetch": {
            "type": "boolean"
          },
          "article_hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "language",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preferred_publishers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "publisher",
            "ollama",
            "openai_compatible"
          ]
        },
        "max_words": {
          "type": "integer",
          "minimum": 20,
          "maximum": 250
        },
        "endpoint": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "parameters": {
          "type": "object"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "instructions": {
          "type": "string",
          "maxLength": 2000
        },
        "think": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "max_words",
        "endpoint",
        "model",
        "timeout_seconds",
        "api_key_env",
        "parameters",
        "retries",
        "instructions"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "articles_per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "paper_size": {
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "adaptive": {
          "type": "boolean"
        }
      },
      "required": [
        "pages",
        "articles_per_page",
        "columns",
        "paper_size",
        "adaptive"
      ],
      "additionalProperties": false
    },
    "print": {
      "type": "object",
      "properties": {
        "printer": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_.-]+$"
        },
        "duplex": {
          "enum": [
            "off",
            "long-edge",
            "short-edge",
            "manual"
          ]
        },
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "color": {
          "enum": [
            "monochrome",
            "color"
          ]
        },
        "reverse_backs": {
          "type": "boolean"
        },
        "auto": {
          "type": "boolean"
        },
        "printers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "quality": {
          "enum": [
            "draft",
            "normal",
            "high",
            "efficient"
          ]
        },
        "preflight": {
          "type": "boolean"
        },
        "prevent_duplicates": {
          "type": "boolean"
        }
      },
      "required": [
        "printer",
        "duplex",
        "copies",
        "color",
        "reverse_backs",
        "auto",
        "printers",
        "quality",
        "preflight",
        "prevent_duplicates"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "keep": {
          "type": "boolean"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "save_manifest": {
          "type": "boolean"
        },
        "max_editions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_age_hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 876000
        },
        "max_total_mb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "keep",
        "directory",
        "save_manifest",
        "max_editions",
        "max_age_hours",
        "max_total_mb",
        "max_files"
      ],
      "additionalProperties": false
    },
    "visuals": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "images",
            "ascii"
          ]
        },
        "grayscale": {
          "type": "boolean"
        },
        "max_images": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "mode",
        "grayscale",
        "max_images"
      ],
      "additionalProperties": false
    },
    "weather": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 35
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "enabled",
        "label",
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "puzzle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "sudoku4",
            "anagram",
            "rotate"
          ]
        }
      },
      "required": [
        "enabled",
        "type"
      ],
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "subtitle": {
          "type": "string",
          "maxLength": 80
        },
        "tagline": {
          "type": "string",
          "maxLength": 100
        },
        "footer": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "title",
        "subtitle",
        "tagline",
        "footer"
      ],
      "additionalProperties": false
    },
    "editorial": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "heuristic",
            "model"
          ]
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "discovery_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "reading_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "words_per_minute": {
          "type": "integer",
          "minimum": 80,
          "maximum": 400
        },
        "cluster_threshold": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.95
        },
        "structured_briefs": {
          "type": "boolean"
        },
        "introduction_every": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "concept": {
          "type": "boolean"
        },
        "cache": {
          "type": "boolean"
        },
        "brief_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "mode",
        "candidate_limit",
        "discovery_count",
        "reading_minutes",
        "words_per_minute",
        "cluster_threshold",
        "structured_briefs",
        "introduction_every",
        "concept",
        "cache",
        "brief_retries"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "repeat_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "max_issues": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_cache_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "enabled",
        "directory",
        "repeat_days",
        "max_issues",
        "max_cache_entries"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "boolean"
        },
        "qr": {
          "type": "boolean"
        }
      },
      "required": [
        "domains",
        "qr"
      ],
      "additionalProperties": false
    },
    "personalization": {
      "type": "object",
      "properties": {
        "vault_path": {
          "type": "string"
        },
        "suggest_every": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "vault_path",
        "suggest_every"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "language",
    "timezone",
    "name",
    "hours",
    "max_articles",
    "publisher_limit",
    "theme",
    "interests",
    "sources",
    "exclude",
    "preferred_publishers",
    "summary",
    "layout",
    "print",
    "storage",
    "visuals",
    "weather",
    "puzzle",
    "branding",
    "editorial",
    "memory",
    "references",
    "personalization"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ulak configuration"
}
